", "distractors": [{"text": "sind", "replaces": "ist", "why": "<b>sind</b> goes with <i>wir or sie (plural)</i>. Here say <b>ist</b>."}, {"text": "kein", "replaces": "nicht", "why": "<b>kein</b> comes before a noun. Before an adjective use <b>nicht</b>."}]}, {"id": "Das ist meine Familie", "de": "Das ist meine Familie", "en": "that is my family", "lesson": 1, "chunks": ["das", "ist", "meine Familie"], "finite": "ist", "accepted": [["das", "ist", "meine Familie"], ["meine Familie", "ist", "das"]], "marked": [1], "derived": null, "distractors": [{"text": "sind", "replaces": "ist", "why": "<b>sind</b> goes with <i>wir or sie (plural)</i>. Here say <b>ist</b>."}, {"text": "meiner Familie", "replaces": "meine Familie", "why": "The sentence is about <b>meine Familie</b>. You only say <i>meiner Familie</i> after words like <i>mit</i>: <i>mit meiner Familie</i>."}]}, {"id": "Mein Hobby ist Laufen", "de": "Mein Hobby ist Laufen", "en": "my hobby is running", "lesson": 1, "chunks": ["mein Hobby", "ist", "Laufen"], "finite": "ist", "accepted": [["mein Hobby", "ist", "Laufen"], ["Laufen", "ist", "mein Hobby"]], "marked": [1], "derived": null, "distractors": [{"text": "sind", "replaces": "ist", "why": "<b>sind</b> goes with <i>wir or sie (plural)</i>. Here say <b>ist</b>."}, {"text": "meinem Hobby", "replaces": "mein Hobby", "why": "The sentence is about <b>mein Hobby</b>. You only say <i>meinem Hobby</i> after words like <i>mit</i>: <i>mit meinem Hobby</i>."}]}, {"id": "Ich bin zwanzig Jahre alt", "de": "Ich bin zwanzig Jahre alt", "en": "I am twenty years old", "lesson": 1, "chunks": ["ich", "bin", "zwanzig Jahre", "alt"], "finite": "bin", "accepted": [["ich", "bin", "zwanzig Jahre", "alt"]], "marked": [], "derived": null, "distractors": [{"text": "bist", "replaces": "bin", "why": "<b>bist</b> goes with <i>du</i>. Here say <b>bin</b>."}, {"text": "ist", "replaces": "bin", "why": "<b>ist</b> goes with <i>er or sie</i>. Here say <b>bin</b>."}]}, {"id": "Wir sind verheiratet", "d